# 管理介面網址，必須與瀏覽器網址列完全相同（CAFECA 簽章會綁定此 origin）
# HTTPS 支援（M2）完成前，請以 SSH 通道連線：ssh -L 8080:localhost:8080 <主機>
# M2 之後可改為 https://caloud.example.com
CALOUD_PUBLIC_ORIGIN=http://localhost:8080
# CAFECA 錢包網址
CALOUD_CAFECA_WALLET=https://cafeca.io
# 選填：自架 RPC
CALOUD_CAFECA_RPC=
CALOUD_ACME_EMAIL=ops@example.com
CALOUD_ACME_STAGING=false
# 第一位以外的新使用者預設角色：pending（需核准）或 member
CALOUD_DEFAULT_ROLE=pending
RUST_LOG=info,caloud=debug
